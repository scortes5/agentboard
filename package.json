{
  "name": "agentboard",
  "productName": "AgentBoard",
  "version": "0.7.0",
  "description": "A desktop board of real terminals to run Claude Code, Codex, Gemini CLI and other coding agents side by side, on your own subscriptions. macOS and Windows.",
  "keywords": [
    "claude-code",
    "codex",
    "gemini-cli",
    "ai-agents",
    "coding-agents",
    "agent-orchestration",
    "multi-agent",
    "mcp",
    "electron",
    "terminal",
    "xterm",
    "worktree",
    "developer-tools",
    "llm",
    "productivity"
  ],
  "author": "Sergio Cortés",
  "license": "MIT",
  "homepage": "https://github.com/scortes5/agentboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scortes5/agentboard.git"
  },
  "bugs": {
    "url": "https://github.com/scortes5/agentboard/issues"
  },
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-agents.js",
    "app": "node scripts/install-app.js",
    "icon": "python3 scripts/make-icon.py",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "postinstall": "node scripts/fix-pty.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "geist": "^1.8.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "cl.scortes.agentboard",
    "productName": "AgentBoard",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "scripts/agentboard-mcp.js",
      "skills-pack/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "scripts/agentboard-mcp.js"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "scortes5",
        "repo": "agentboard"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
